# Copia este archivo como .env.production SOLO en tu equipo o CI.
# No subas el archivo real con valores a repositorios públicos.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Opcional. Configúralo únicamente después de registrar la aplicación web
# en Firebase App Check y antes de habilitar enforcement.
VITE_FIREBASE_APPCHECK_SITE_KEY=
