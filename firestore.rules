rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Verifica si es el propietario (admin raíz)
    // El email del propietario debe ser quien administra el sistema
    function isOwner() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'almacen@arlessas.com';
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActive(profile) {
      let hasActivo = 'activo' in profile;
      let hasEstado = 'estado' in profile;
      return (!hasActivo || profile.activo != false)
        && (
          (hasActivo && profile.activo == true)
          || (hasEstado && profile.estado in ['activo', 'Activo', 'ACTIVO'])
        )
        && !(hasEstado && profile.estado in [
          'inactivo', 'Inactivo', 'INACTIVO',
          'desactivado', 'Desactivado', 'DESACTIVADO',
          'bloqueado', 'Bloqueado', 'BLOQUEADO',
          'suspendido', 'Suspendido', 'SUSPENDIDO'
        ]);
    }

    function hasAllowedRole(profile) {
      let allowedRoles = [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'administrador', 'Administrador', 'ADMINISTRADOR',
        'almacenista', 'Almacenista', 'ALMACENISTA',
        'operador', 'Operador', 'OPERADOR'
      ];
      
      return ('rol' in profile && profile.rol in allowedRoles)
        || ('role' in profile && profile.role in allowedRoles);
    }

    function isActiveUser() {
      return isOwner()
        || (hasUserProfile() 
            && isActive(userProfile()) 
            && hasAllowedRole(userProfile()));
    }

    function isAdmin(profile) {
      let adminRoles = [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'administrador', 'Administrador', 'ADMINISTRADOR'
      ];
      
      return ('rol' in profile && profile.rol in adminRoles)
        || ('role' in profile && profile.role in adminRoles);
    }

    function hasAdminAccess() {
      return isOwner()
        || (hasUserProfile() 
            && isActive(userProfile()) 
            && isAdmin(userProfile()));
    }

    // Stage 1: operational users do not administer financial history.
    function canManageInventory() {
      return hasAdminAccess() || (hasUserProfile() && isActive(userProfile())
        && (userProfile().get('rol', '') in ['almacenista', 'Almacenista', 'ALMACENISTA']
          || userProfile().get('role', '') in ['almacenista', 'Almacenista', 'ALMACENISTA']));
    }

    function nonNegativeIfPresent(data, field) {
      // Infinity - Infinity is not zero; reject non-finite values without a business quantity cap.
      return !(field in data) || (data[field] is number && data[field] >= 0 && data[field] - data[field] == 0);
    }

    function validStockNumbers(data) {
      return nonNegativeIfPresent(data, 'cantidad')
        && nonNegativeIfPresent(data, 'stock_actual')
        && nonNegativeIfPresent(data, 'stock')
        && nonNegativeIfPresent(data, 'saldo');
    }

    function validStock(data) {
      return data.keys().hasAny(['cantidad', 'stock_actual', 'stock', 'saldo']) && validStockNumbers(data);
    }

    function catalogEditableFields() {
      return ['modulo', 'categoria', 'subcategoria', 'item', 'referencia',
        'marca', 'nombre_completo', 'busqueda', 'codigo_interno', 'codigo_original',
        'documento_id', 'producto_id', 'unidad', 'ubicacion', 'ultima_fecha',
        'ultimo_solicitante', 'activo', 'cantidad', 'stock_actual', 'stock', 'saldo',
        'origen_area_cop', 'documento_origen_area', 'origen_canonico', 'version_canonica',
        'peso_envase', 'unidad_envase', 'referencia_catalogo'];
    }

    function catalogTextIfPresent(data, field) {
      return !(field in data) || data[field] is string;
    }

    function validCatalogProduct(data, documentId) {
      return data.keys().hasAll(['modulo', 'item', 'codigo_interno'])
        && data.modulo is string && data.modulo.size() > 0
        && data.item is string && data.item.size() > 0
        && data.codigo_interno is string && data.codigo_interno.size() > 0
        && catalogTextIfPresent(data, 'categoria')
        && catalogTextIfPresent(data, 'subcategoria')
        && catalogTextIfPresent(data, 'referencia')
        && catalogTextIfPresent(data, 'codigo_original')
        && catalogTextIfPresent(data, 'unidad')
        && catalogTextIfPresent(data, 'ubicacion')
        && (!('documento_id' in data) || data.documento_id == documentId)
        && (!('producto_id' in data) || data.producto_id == documentId)
        && (!('activo' in data) || data.activo is bool)
        && validStockNumbers(data)
        && nonNegativeIfPresent(data, 'peso_envase');
    }

    function preservesExistingFields() {
      return request.resource.data.keys().hasAll(resource.data.keys());
    }

    function validToolStock(data) {
      return data.keys().hasAny(['cantidad', 'cantidad_total', 'stock_total', 'cantidad_disponible'])
        && validStockNumbers(data)
        && nonNegativeIfPresent(data, 'cantidad_total')
        && nonNegativeIfPresent(data, 'stock_total')
        && nonNegativeIfPresent(data, 'cantidad_disponible')
        && nonNegativeIfPresent(data, 'cantidad_ocupada');
    }

    function validNewMovement(data) {
      // Legacy mobile tool movements can encode quantity as a decimal string.
      return !('cantidad' in data)
        || (data.cantidad is number && data.cantidad >= 0)
        || (data.cantidad is string && data.cantidad.matches('^[0-9]+([.,][0-9]+)?( [^0-9-].*)?$'));
    }

    function validCloseOwner(data, period) {
      return period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.periodo == period
        && data.usuario_uid == request.auth.uid
        && data.intento_id is string && data.intento_id.size() > 0
        && data.resumen.valor_total is number && data.resumen.valor_total >= 0
        && data.resumen.cantidad_productos is int && data.resumen.cantidad_productos > 0;
    }

    function validCloseTransition(period) {
      let before = resource.data;
      let after = request.resource.data;
      return validCloseOwner(after, period) && validClosePulse(after)
        && after.get('recuperacion', null) == before.get('recuperacion', null)
        && ((before.estado == 'error' && after.estado == 'guardando'
            && (before.usuario_uid == request.auth.uid
              || (before.get('recuperacion', {}).get('por_uid', '') == request.auth.uid
                && before.get('recuperacion', {}).get('intento_id', '') == before.intento_id))
            && after.intento_id != before.intento_id)
          || (before.estado == 'guardando' && before.usuario_uid == request.auth.uid
            && closeLeaseActive(before) && after.intento_id == before.intento_id
            && ((after.estado == 'guardando' && after.diff(before).affectedKeys().hasOnly(['pulso']))
              || (after.diff(before).affectedKeys().hasOnly(['estado', 'fecha', 'verificacion', 'pulso'])
                && (after.estado == 'error'
                  || (after.estado == 'completo' && after.fecha == request.time && after.verificacion.verificado == true
                    && after.verificacion.cantidad_items == after.resumen.cantidad_productos))))));
    }

    function validClosePulse(data) {
      return data.protocolo_cierre == 2 && data.pulso == request.time;
    }

    function closeLeaseActive(data) {
      return data.protocolo_cierre == 2 && data.pulso is timestamp
        && data.pulso <= request.time && request.time < data.pulso + duration.value(15, 'm');
    }

    function closeLastPulse(data) {
      return data.get('protocolo_cierre', 1) == 2 ? data.get('pulso', null) : data.get('fecha', null);
    }

    function validCloseRecovery(before, after) {
      let lastPulse = closeLastPulse(before);
      let recovery = after.recuperacion;
      return before.estado == 'guardando' && after.estado == 'error'
        && lastPulse is timestamp && request.time >= lastPulse + duration.value(15, 'm')
        && after.diff(before).affectedKeys().hasOnly(['estado', 'recuperacion'])
        && recovery.keys().hasOnly(['intento_id', 'por_uid', 'fecha', 'usuario_original', 'ultimo_pulso'])
        && recovery.intento_id == before.intento_id && recovery.por_uid == request.auth.uid
        && recovery.fecha == request.time && recovery.usuario_original == before.usuario_uid
        && recovery.ultimo_pulso == lastPulse;
    }

    function canWriteCloseDetail(period) {
      let closePath = /databases/$(database)/documents/cierres_valoracion_inventario/$(period);
      let before = get(closePath).data;
      let after = getAfter(closePath).data;
      return canManageInventory() && before.estado == 'guardando'
        && closeLeaseActive(before) && validClosePulse(after)
        && before.usuario_uid == request.auth.uid
        && after.estado == 'guardando' && after.usuario_uid == request.auth.uid
        && after.intento_id == before.intento_id;
    }

    function isAgrochemicalParent(parentPath) {
      return exists(/databases/$(database)/documents/$(parentPath))
        && get(/databases/$(database)/documents/$(parentPath)).data.modulo in [
          'Agroquimicos', 'Agroquímicos', 'AGROQUIMICOS', 'AGROQUÍMICOS'
        ];
    }

    function validAgrochemicalLot(data) {
      return data.keys().hasAll([
          'producto_id', 'numero_lote', 'fecha_vencimiento',
          'cantidad_inicial', 'cantidad_disponible', 'unidad'
        ])
        && data.producto_id is string
        && data.numero_lote is string
        && data.fecha_vencimiento is string
        && data.fecha_vencimiento.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
        && data.cantidad_inicial is number
        && data.cantidad_inicial >= 0
        && data.cantidad_disponible is number
        && data.cantidad_disponible >= 0
        && data.cantidad_disponible <= data.cantidad_inicial
        && data.unidad is string;
    }

    function validAgrochemicalEntryAssignment(data) {
      return data.keys().hasAll([
          'entrada_id', 'producto_id', 'cantidad_entrada', 'cantidad_asignada'
        ])
        && data.entrada_id is string
        && data.producto_id is string
        && data.cantidad_entrada is number
        && data.cantidad_entrada > 0
        && data.cantidad_asignada is number
        && data.cantidad_asignada >= 0
        && data.cantidad_asignada <= data.cantidad_entrada;
    }

    // ========================================
    // REGLAS POR COLECCIÓN
    // ========================================

    // Perfiles de usuario: los usuarios autorizados pueden leerlos porque el
    // panel usa esta colección para responsables/reportes. Solo administradores
    // pueden crear, modificar o eliminar perfiles y roles.
    match /usuarios/{uid} {
      allow get: if isActiveUser()
        || (signedIn() && request.auth.uid == uid);
      allow list: if isActiveUser();
      // Una cuenta recién registrada puede crear únicamente su perfil pendiente.
      // La activación y la asignación de rol quedan reservadas a administradores.
      allow create: if hasAdminAccess()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.auth.token.email.matches('^[^@]+@arlessas[.]com$')
          && request.resource.data.rol == 'pendiente'
          && request.resource.data.get('role', 'pendiente') == 'pendiente'
          && request.resource.data.activo == false
          && request.resource.data.estado == 'pendiente');
      allow update, delete: if hasAdminAccess();
    }

    // Colecciones operativas utilizadas por el panel y por los flujos de
    // inventario. El acceso requiere autenticación + perfil activo + rol válido.
    match /existencias/{documentId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validStock(request.resource.data);
      allow update: if isActiveUser() && validStock(request.resource.data) && preservesExistingFields();
      allow delete: if false;
    }

    // Catalog maintenance is distinct from an ordinary stock entry. Operators
    // read product cards but register existing-stock movements without editing them.
    match /catalogo_personalizado/{documentId} {
      allow read: if isActiveUser();
      allow create: if canManageInventory()
        && request.resource.data.keys().hasOnly(catalogEditableFields())
        && validCatalogProduct(request.resource.data, documentId);
      allow update: if canManageInventory()
        && preservesExistingFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(catalogEditableFields())
        && validCatalogProduct(request.resource.data, documentId);
      allow delete: if false;
    }

    // Conserva compatibilidad con subcolecciones operativas anteriores. Los dos
    // nombres de trazabilidad agroquímica se validan en sus reglas dedicadas.
    match /existencias/{productId}/{subcollection}/{document=**} {
      allow read: if isActiveUser();
      allow create, update: if canManageInventory()
        && !(subcollection in [
          'lotes_agroquimicos', 'asignaciones_entradas_agroquimicos'
        ]);
      allow delete: if false;
    }

    match /movimientos/{document=**} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validNewMovement(request.resource.data);
      // Identical retries are harmless; edits and deletes require a separate,
      // audited administrative correction, not an ordinary client write.
      allow update: if isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
      allow delete: if false;
    }

    match /productos_aseo/{document=**} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validStock(request.resource.data);
      allow update: if isActiveUser() && validStock(request.resource.data) && preservesExistingFields();
      allow delete: if false;
    }

    match /herramientas/{document=**} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validToolStock(request.resource.data);
      allow update: if isActiveUser() && validToolStock(request.resource.data) && preservesExistingFields();
      allow delete: if false;
    }

    match /valoraciones_inventario/{document=**} {
      allow read: if isActiveUser();
      allow create, update: if canManageInventory()
        && request.resource.data.valor_unitario is number
        && request.resource.data.valor_unitario >= 0
        && request.resource.data.actualizado_por_uid == request.auth.uid;
      allow delete: if false;
    }

    match /valoraciones_entradas/{document=**} {
      allow read: if isActiveUser();
      allow create: if canManageInventory() && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.valor_unitario_entrada is number
        && request.resource.data.valor_unitario_entrada >= 0;
      allow update, delete: if false;
    }

    match /entradas_stock/{document=**} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validNewMovement(request.resource.data);
      allow update: if isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
      allow delete: if false;
    }

    // Los lotes se almacenan bajo existencias/{productoId}. El comodín recursivo
    // permite consultas collectionGroup sin abrir otras colecciones.
    match /{parentPath=**}/lotes_agroquimicos/{lotId} {
      allow read: if isActiveUser();
      // Stage 2: only the authenticated server transaction may assign or deduct
      // lots. An old tab must not bypass the product lock or the operation receipt.
      allow write: if false;
    }

    match /{parentPath=**}/asignaciones_entradas_agroquimicos/{entryId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /operaciones_lotes_agroquimicos/{operationId} {
      allow read: if canManageInventory();
      allow write: if false;
    }

    match /controles_lotes_agroquimicos/{productId} {
      allow read: if canManageInventory();
      allow write: if false;
    }

    match /cierres_valoracion_inventario/{periodo} {
      allow read: if isActiveUser();
      allow create: if canManageInventory() && validCloseOwner(request.resource.data, periodo)
        && request.resource.data.estado == 'guardando' && validClosePulse(request.resource.data)
        && !('recuperacion' in request.resource.data);
      allow update: if canManageInventory() && (validCloseTransition(periodo)
        || (validCloseRecovery(resource.data, request.resource.data)
          && getAfter(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)/recuperaciones/$(resource.data.intento_id)).data == request.resource.data.recuperacion));
      allow delete: if false;

      match /recuperaciones/{attemptId} {
        allow read: if isActiveUser();
        allow create: if canManageInventory()
          && attemptId == get(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)).data.intento_id
          && validCloseRecovery(get(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)).data,
            getAfter(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)).data)
          && request.resource.data == getAfter(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)).data.recuperacion;
        allow update, delete: if false;
      }

      match /items/{itemId} {
        allow read: if isActiveUser();
        allow create, update: if canWriteCloseDetail(periodo)
          && request.resource.data.intento_id == get(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)).data.intento_id;
        allow delete: if canWriteCloseDetail(periodo);
      }
      match /movimientos/{movementId} {
        allow read: if isActiveUser();
        allow create, update: if canWriteCloseDetail(periodo)
          && request.resource.data.intento_id == get(/databases/$(database)/documents/cierres_valoracion_inventario/$(periodo)).data.intento_id;
        allow delete: if canWriteCloseDetail(periodo);
      }
    }

    // Cualquier colección no declarada queda cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
