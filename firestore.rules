rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Verifica si es el propietario (admin raíz)
    // El email del propietario debe ser quien administra el sistema
    function isOwner() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'almacen@arlessas.com';
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActive(profile) {
      let hasActivo = 'activo' in profile;
      let hasEstado = 'estado' in profile;
      return (!hasActivo || profile.activo != false)
        && (
          (hasActivo && profile.activo == true)
          || (hasEstado && profile.estado in ['activo', 'Activo', 'ACTIVO'])
        )
        && !(hasEstado && profile.estado in [
          'inactivo', 'Inactivo', 'INACTIVO',
          'desactivado', 'Desactivado', 'DESACTIVADO',
          'bloqueado', 'Bloqueado', 'BLOQUEADO',
          'suspendido', 'Suspendido', 'SUSPENDIDO'
        ]);
    }

    function hasAllowedRole(profile) {
      let allowedRoles = [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'administrador', 'Administrador', 'ADMINISTRADOR',
        'almacenista', 'Almacenista', 'ALMACENISTA',
        'operador', 'Operador', 'OPERADOR'
      ];
      
      return ('rol' in profile && profile.rol in allowedRoles)
        || ('role' in profile && profile.role in allowedRoles);
    }

    function isActiveUser() {
      return isOwner()
        || (hasUserProfile() 
            && isActive(userProfile()) 
            && hasAllowedRole(userProfile()));
    }

    function isAdmin(profile) {
      let adminRoles = [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'administrador', 'Administrador', 'ADMINISTRADOR'
      ];
      
      return ('rol' in profile && profile.rol in adminRoles)
        || ('role' in profile && profile.role in adminRoles);
    }

    function hasAdminAccess() {
      return isOwner()
        || (hasUserProfile() 
            && isActive(userProfile()) 
            && isAdmin(userProfile()));
    }

    function isAgrochemicalParent(parentPath) {
      return exists(/databases/$(database)/documents/$(parentPath))
        && get(/databases/$(database)/documents/$(parentPath)).data.modulo in [
          'Agroquimicos', 'Agroquímicos', 'AGROQUIMICOS', 'AGROQUÍMICOS'
        ];
    }

    function validAgrochemicalLot(data) {
      return data.keys().hasAll([
          'producto_id', 'numero_lote', 'fecha_vencimiento',
          'cantidad_inicial', 'cantidad_disponible', 'unidad'
        ])
        && data.producto_id is string
        && data.numero_lote is string
        && data.fecha_vencimiento is string
        && data.fecha_vencimiento.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
        && data.cantidad_inicial is number
        && data.cantidad_inicial >= 0
        && data.cantidad_disponible is number
        && data.cantidad_disponible >= 0
        && data.cantidad_disponible <= data.cantidad_inicial
        && data.unidad is string;
    }

    function validAgrochemicalEntryAssignment(data) {
      return data.keys().hasAll([
          'entrada_id', 'producto_id', 'cantidad_entrada', 'cantidad_asignada'
        ])
        && data.entrada_id is string
        && data.producto_id is string
        && data.cantidad_entrada is number
        && data.cantidad_entrada > 0
        && data.cantidad_asignada is number
        && data.cantidad_asignada >= 0
        && data.cantidad_asignada <= data.cantidad_entrada;
    }

    // ========================================
    // REGLAS POR COLECCIÓN
    // ========================================

    // Perfiles de usuario: los usuarios autorizados pueden leerlos porque el
    // panel usa esta colección para responsables/reportes. Solo administradores
    // pueden crear, modificar o eliminar perfiles y roles.
    match /usuarios/{uid} {
      allow get: if isActiveUser()
        || (signedIn() && request.auth.uid == uid);
      allow list: if isActiveUser();
      // Una cuenta recién registrada puede crear únicamente su perfil pendiente.
      // La activación y la asignación de rol quedan reservadas a administradores.
      allow create: if hasAdminAccess()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.auth.token.email.matches('^[^@]+@arlessas[.]com$')
          && request.resource.data.rol == 'pendiente'
          && request.resource.data.activo == false
          && request.resource.data.estado == 'pendiente');
      allow update, delete: if hasAdminAccess();
    }

    // Colecciones operativas utilizadas por el panel y por los flujos de
    // inventario. El acceso requiere autenticación + perfil activo + rol válido.
    match /existencias/{documentId} {
      allow read, write: if isActiveUser();
    }

    // Conserva compatibilidad con subcolecciones operativas anteriores. Los dos
    // nombres de trazabilidad agroquímica se validan en sus reglas dedicadas.
    match /existencias/{productId}/{subcollection}/{document=**} {
      allow read, write: if isActiveUser()
        && !(subcollection in [
          'lotes_agroquimicos', 'asignaciones_entradas_agroquimicos'
        ]);
    }

    match /movimientos/{document=**} {
      allow read, write: if isActiveUser();
    }

    match /productos_aseo/{document=**} {
      allow read, write: if isActiveUser();
    }

    match /herramientas/{document=**} {
      allow read, write: if isActiveUser();
    }

    match /valoraciones_inventario/{document=**} {
      allow read, write: if isActiveUser();
    }

    match /valoraciones_entradas/{document=**} {
      allow read, write: if isActiveUser();
    }

    match /entradas_stock/{document=**} {
      allow read, write: if isActiveUser();
    }

    // Los lotes se almacenan bajo existencias/{productoId}. El comodín recursivo
    // permite consultas collectionGroup sin abrir otras colecciones.
    match /{parentPath=**}/lotes_agroquimicos/{lotId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && isAgrochemicalParent(parentPath)
        && validAgrochemicalLot(request.resource.data);
      allow update: if isActiveUser()
        && isAgrochemicalParent(parentPath)
        && validAgrochemicalLot(request.resource.data)
        && request.resource.data.producto_id == resource.data.producto_id
        && request.resource.data.numero_lote == resource.data.numero_lote
        && request.resource.data.fecha_vencimiento == resource.data.fecha_vencimiento;
      allow delete: if false;
    }

    match /{parentPath=**}/asignaciones_entradas_agroquimicos/{entryId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && isAgrochemicalParent(parentPath)
        && validAgrochemicalEntryAssignment(request.resource.data)
        && request.resource.data.entrada_id == entryId;
      allow update: if isActiveUser()
        && isAgrochemicalParent(parentPath)
        && validAgrochemicalEntryAssignment(request.resource.data)
        && request.resource.data.entrada_id == entryId
        && request.resource.data.entrada_id == resource.data.entrada_id
        && request.resource.data.producto_id == resource.data.producto_id;
      allow delete: if false;
    }

    match /cierres_valoracion_inventario/{periodo} {
      allow read, write: if isActiveUser();

      match /items/{itemId} {
        allow read, write: if isActiveUser();
      }
      match /movimientos/{movementId} {
        allow read, write: if isActiveUser();
      }
    }

    // Cualquier colección no declarada queda cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
