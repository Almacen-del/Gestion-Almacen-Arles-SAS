# Copia este archivo como .env.local y reemplaza los ejemplos localmente.
# Nunca publiques .env.local ni compartas sus valores.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Opcional en desarrollo. Para producción, registra la app web en Firebase App Check
# y configura la clave pública de sitio de reCAPTCHA v3 antes de habilitar enforcement.
VITE_FIREBASE_APPCHECK_SITE_KEY=
